   "source": [
    "import numpy as np\n",
    "def rolling_volatility(returns,window):\n",
    "    returns = np.asarray(returns)\n",
    "    vol = []\n",
    "\n",
    "    for i in range(window-1, len(returns)):\n",
    "        window_slice = returns[i - window +1, i + 1]\n",
    "        vol.append(np.std(window_slice))\n",
    "    \n",
    "    return np.array(vol)\n"
   ]
  }
